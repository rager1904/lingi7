# ─────────────────────────────────────────────────────────────
# Lingi7 Platform — Environment Variables
# ─────────────────────────────────────────────────────────────

# API key for internal model and agent services. Generate a high-entropy value.
API_KEY=

# Shared internal-service key: sent by Django as `X-Internal-Api-Key` when
# calling the catalog enrichment service, which requires it on every endpoint
# except /health. Must match between Django and the enrichment backend.
INTERNAL_API_KEY=

# HuggingFace token for gated models (Llama, FLUX, etc.)
HF_TOKEN=

# ── Django ──────────────────────────────────────────────────
POSTGRES_DB=lingi7_dev
POSTGRES_USER=lingi7
POSTGRES_PASSWORD=
SECRET_KEY=
DJANGO_DEBUG=True

# Object storage used by Milvus.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
