# ─────────────────────────────────────────────────────────────────────────────
# Lingi7 — Environment Variable Template
#
# COPY this file to .env.dev for local development.
# NEVER commit .env.dev or any file containing real secrets to git.
# In production, inject all variables via your secrets manager or VPS env.
#
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_command_above
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# Primary operational database
DATABASE_URL=postgres://lingi7:lingi7_dev_password@localhost:5432/lingi7_dev
POSTGRES_DB=lingi7_dev
POSTGRES_USER=lingi7
POSTGRES_PASSWORD=lingi7_dev_password

# Isolated escrow ledger schema (same DB, separate schema)
# The escrow service user has WRITE access only to this schema.
ESCROW_LEDGER_SCHEMA=escrow_ledger
ESCROW_DB_USER=lingi7_escrow
ESCROW_DB_PASSWORD=CHANGE_ME_escrow_db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Payments — MTN Mobile Money ───────────────────────────────────────────────
# Obtain sandbox credentials at: https://momodeveloper.mtn.com
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=CHANGE_ME
MTN_MOMO_COLLECTION_USER_ID=CHANGE_ME       # UUID for collections
MTN_MOMO_COLLECTION_API_KEY=CHANGE_ME       # API key for collections
MTN_MOMO_DISBURSEMENT_USER_ID=CHANGE_ME     # UUID for disbursements
MTN_MOMO_DISBURSEMENT_API_KEY=CHANGE_ME     # API key for disbursements
MTN_MOMO_ENVIRONMENT=sandbox       # sandbox | production
MTN_MOMO_CURRENCY=ZMW
MTN_MOMO_CALLBACK_URL=https://your-ngrok-or-staging-url.com   # For webhook delivery

# ── Payments — Airtel Money ───────────────────────────────────────────────────
# Obtain credentials at: https://developers.airtel.africa
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=CHANGE_ME
AIRTEL_CLIENT_SECRET=CHANGE_ME
AIRTEL_ENVIRONMENT=staging         # staging | production
AIRTEL_CURRENCY=ZMW
AIRTEL_COUNTRY=ZM

# ── Object Storage (AWS S3 or Cloudflare R2) ──────────────────────────────────
# For local dev, files are stored locally. Set these for staging/prod.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_STORAGE_BUCKET_NAME=lingi7-media
AWS_S3_REGION_NAME=af-south-1
# For Cloudflare R2 (preferred — no egress fees, GDPR-friendly):
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME

# ── Email (Transactional) ─────────────────────────────────────────────────────
# Dev: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend (set in dev.py)
# Prod: Use Mailgun, SendGrid, or AWS SES
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@lingi7.co.zm

# ── SMS ───────────────────────────────────────────────────────────────────────
# Zambia SMS gateway (e.g. Zuku, Africa's Talking)
SMS_API_KEY=CHANGE_ME
SMS_SENDER_ID=Lingi7

# ── Sentry (Error Monitoring) ─────────────────────────────────────────────────
SENTRY_DSN=CHANGE_ME   # Get from sentry.io after creating project

# ── ML Model ─────────────────────────────────────────────────────────────────
# Path or S3 URI for the trained fraud detection model artifact
ML_FRAUD_MODEL_PATH=ml/fraud/models/fraud_model_v1.joblib
# Score threshold above which an order is automatically FROZEN
ML_FRAUD_SCORE_THRESHOLD=0.65

# ── Security ──────────────────────────────────────────────────────────────────
# CORS: comma-separated list of allowed origins for the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Internal API key used by services calling the fraud scoring endpoint
INTERNAL_API_KEY=CHANGE_ME_generate_random_256bit_hex

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
