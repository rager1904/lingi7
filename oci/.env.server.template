# ─────────────────────────────────────────────────────────────────────────────
# Lingi7 — Server-side .env template (Oracle Cloud)
#
# Copy this to /opt/lingi7/.env on the CPU host and replace the values.
# deploy-cpu.sh generates secure random values automatically the first time
# it runs, so you normally do NOT need to fill this in manually.
#
# The values below are interpolated by docker-compose.yml. They OVERRIDE the
# committed dev values in lingi7/.env.dev, so the real secrets live only on
# the server and stay out of git.
# ─────────────────────────────────────────────────────────────────────────────

# Internal API keys (generate:  openssl rand -hex 32)
API_KEY=
INTERNAL_API_KEY=

# Django signing secret (generate:  openssl rand -hex 64)
SECRET_KEY=

# PostgreSQL (lingi7-web + lingi7-celery + lingi7-beat connect via DATABASE_URL)
POSTGRES_DB=lingi7_prod
POSTGRES_USER=lingi7
POSTGRES_PASSWORD=

# MinIO object storage used by Milvus (MINIO_ROOT_USER >= 3 chars, password >= 8)
MINIO_ROOT_USER=lingi7minio
MINIO_ROOT_PASSWORD=

# Optional: Hugging Face token for gated models (FLUX.1-schnell lives on the
# GPU host; set it there instead. BGE/CLIP defaults here are NOT gated.)
HF_TOKEN=